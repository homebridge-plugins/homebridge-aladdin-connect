{
  "name": "@homebridge-plugins/homebridge-aladdin-connect",
  "displayName": "Aladdin Connect",
  "type": "module",
  "version": "4.3.0",
  "description": "Aladdin Connect plugin for Homebridge.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/homebridge-plugins/homebridge-aladdin-connect.git"
  },
  "bugs": {
    "url": "https://github.com/homebridge-plugins/homebridge-aladdin-connect/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "genie",
    "aladdin",
    "connect"
  ],
  "main": "dist/index.js",
  "engines": {
    "homebridge": "^1.8.5 || ^2.0.0 || ^2.0.0-beta.23 || ^2.0.0-alpha.37",
    "node": "^20 || ^22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "npm install && npm outdated",
    "lint": "eslint src/**/*.ts --max-warnings=0",
    "lint:fix": "eslint src/**/*.ts  --max-warnings=0 --fix",
    "watch": "npm run build && npm run plugin-ui && npm link && nodemon",
    "plugin-ui": "rsync ./src/homebridge-ui/public/index.html ./dist/homebridge-ui/public/",
    "build": "npm run clean && tsc && npm run plugin-ui",
    "prepublishOnly": "npm run lint && npm run build && npm run plugin-ui && npm run docs && npm run docs:lint && npm run docs:theme",
    "postpublish": "npm run clean && npm ci",
    "clean": "shx rm -rf ./dist",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test-coverage": "npm run test -- --coverage",
    "roomba:getpassword": "get-roomba-password",
    "roomba:getlastcommand": "node ./dist/lastcommand.js",
    "docs": "typedoc",
    "docs:lint": "typedoc --emit none --treatWarningsAsErrors",
    "docs:theme": "typedoc --theme default-modern"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.0.1",
    "async-lock": "^1.4.1",
    "axios": "^1.7.9",
    "axios-retry": "^4.5.0",
    "cache-manager": "^6.4.0",
    "cacheable": "^1.8.8",
    "form-data": "^4.0.2",
    "keyv": "^5.2.3",
    "pubsub-js": "^1.9.5",
    "qs": "^6.14.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.1.0",
    "@changesets/cli": "^2.27.12",
    "@types/aes-js": "^3.1.4",
    "@types/async-lock": "^1.4.2",
    "@types/cache-manager": "^4.0.6",
    "@types/debug": "^4.1.12",
    "@types/fs-extra": "^11.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.13.0",
    "@types/promise-timeout": "^1.3.0",
    "@types/pubsub-js": "^1.8.6",
    "@types/semver": "^7.5.8",
    "@types/source-map-support": "^0.5.10",
    "@typhonjs-typedoc/typedoc-theme-dmt": "^0.3.1",
    "@vitest/coverage-v8": "^3.0.4",
    "eslint": "^9.19.0",
    "eslint-plugin-format": "^1.0.1",
    "homebridge": "^1.8.5",
    "homebridge-config-ui-x": "4.71.2",
    "nodemon": "^3.1.9",
    "shx": "^0.3.4",
    "ts-node": "^10.9.2",
    "typedoc": "^0.27.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
