{
  "displayName": "Aladdin Connect",
  "name": "@homebridge-plugins/homebridge-aladdin-connect",
  "version": "4.3.2",
  "description": "Aladdin Connect plugin for Homebridge.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/homebridge-plugins/homebridge-aladdin-connect.git"
  },
  "bugs": {
    "url": "https://github.com/homebridge-plugins/homebridge-aladdin-connect/issues"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.11.0 || ^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "npm install && npm outdated",
    "eslint": "eslint src/**.ts --max-warnings=0",
    "eslint-fix": "eslint src/**.ts --max-warnings=0 --fix",
    "prettier": "prettier --check src *.{yaml,json,md}",
    "prettier-fix": "prettier --write src *.{yaml,json,md}",
    "lint": "npm run eslint",
    "lint-fix": "npm run eslint-fix && npm run prettier-fix",
    "fmt": "npm run lint-fix",
    "watch": "npm run build && npm link && nodemon",
    "build": "rm -rf ./dist && tsc",
    "test": "npm install",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "keywords": [
    "homebridge-plugin",
    "genie",
    "aladdin",
    "connect"
  ],
  "dependencies": {
    "async-lock": "^1.4.1",
    "axios": "^1.12.2",
    "axios-retry": "^4.5.0",
    "cache-manager": "^7.2.9",
    "cacheable": "^2.5.0",
    "form-data": "^4.0.1",
    "keyv": "^5.6.0",
    "pubsub-js": "^1.9.5",
    "qs": "^6.14.0"
  },
  "devDependencies": {
    "@types/async-lock": "^1.4.2",
    "@types/cache-manager": "^4.0.6",
    "@types/node": "^24.5.2",
    "@types/pubsub-js": "^1.8.6",
    "@typescript-eslint/eslint-plugin": "<9",
    "@typescript-eslint/parser": "<9",
    "eslint": "<9",
    "homebridge": "^2.4.0",
    "homebridge-config-ui-x": "^5.6.1",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}